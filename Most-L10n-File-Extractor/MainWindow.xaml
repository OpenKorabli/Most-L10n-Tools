<Window x:Class="Most_L10n_File_Extractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Most_L10n_File_Extractor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Most安装目录：" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="InstallPathTextBox" Width="520" VerticalAlignment="Center" LostFocus="InstallPathTextBox_LostFocus" />
            <Button x:Name="BrowseButton" Content="浏览..." Margin="10,0,0,0" Click="BrowseButton_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,30,0,0">
            <TextBlock Text="Mod缓存目录：" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="ModCachePathTextBox" Width="520" VerticalAlignment="Center" LostFocus="ModCachePathTextBox_LostFocus" />
            <Button x:Name="BrowseModCacheButton" Content="浏览..." Margin="10,0,0,0" Click="BrowseModCacheButton_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,60,0,0">
            <Button x:Name="ExportButton" Content="导出语言文件" Width="120" Click="ExportButton_Click" />
            <Button x:Name="ConvertButton" Content="转换为ParaTranz格式" Width="160" Margin="10,0,0,0" Click="ConvertButton_Click" />
            <Button x:Name="ApplyButton" Content="应用翻译文本" Width="120" Margin="10,0,0,0" Click="ApplyButton_Click" />
            <TextBlock x:Name="StatusTextBlock" Text="" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

    </Grid>
</Window>
